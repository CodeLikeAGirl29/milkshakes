<%- include('partials/header'); -%>

    <header class="hero">
        <div class="hero-inner">
            <div class="headings">
                <h2>Milkshakes</h2>
                <p>Hand-blended the old-fashioned way &mdash; real ice cream, real milk, and a handful of classic mix-ins. No shortcuts, no syrups from a gun.</p>
                <a href="/milkshakes" class="btn">View Recipes</a>
                <ul class="hero-slide-numbers" data-hero-numbers>
                    <li><button type="button" class="active" data-slide="0">01</button></li>
                    <li><button type="button" data-slide="1">02</button></li>
                    <li><button type="button" data-slide="2">03</button></li>
                    <li><button type="button" data-slide="3">04</button></li>
                </ul>
            </div>
            <div class="hero-image">
                <img src="/strawberry.png" alt="Assortment of Cold Stone Creamery milkshakes" data-hero-image
                     data-slides="/strawberry.png,/choc-shake.png,/vanilla.png,/bday-cake.png">
            </div>
        </div>
    </header>

    <script>
        (function () {
            var img = document.querySelector('[data-hero-image]');
            var numbers = document.querySelectorAll('[data-hero-numbers] button');
            var slides = img.dataset.slides.split(',');
            var current = 0;

            function showSlide(index) {
                current = index;
                img.src = slides[current];
                numbers.forEach(function (btn) {
                    btn.classList.toggle('active', Number(btn.dataset.slide) === current);
                });
            }

            numbers.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    showSlide(Number(btn.dataset.slide));
                });
            });
        })();
    </script>

    <section class="about">
        <div class="wrap">
            <div class="about-image">
                <img src="/milkshake.png" alt="Strawberry milkshake in a glass">
            </div>
            <div class="about-copy">
                <div class="section-head">
                    <h3>About Cold Stone Creamery</h3>
                    <div class="rule"></div>
                </div>
                <p>We started with one simple idea: a milkshake should taste like the ice cream it's made from. Every recipe here uses full-fat ice cream, whole milk, and fresh mix-ins &mdash; nothing artificial, nothing pre-mixed.</p>
                <a href="/milkshakes" class="btn">Read More</a>
            </div>
        </div>
    </section>

    <section class="featured">
        <div class="wrap section-head">
            <h3>Our Featured Milkshakes</h3>
